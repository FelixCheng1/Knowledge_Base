# ============================================================
# Knowledge_Base 环境变量配置模板
# 复制为 .env 后按实际情况填写（.env 已被 gitignore，不会提交）
# ============================================================

# ---------- minerU（PDF 云端解析） ----------
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache
# Markdown 中间产物输出目录
MD_ROOT_DIR=./temp-files/

# ========== 模型选择 =============
# LLM：任意 OpenAI 兼容接口（智谱 / DeepSeek / Qwen 等）
LLM_DEFAULT_MODEL=GLM-5.3-Flash
VL_MODEL=GLM-5.3-Flash
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_DEFAULT_TEMPERATURE=0.1

# ---------- Embedding 模型（BGE-M3，本地部署） ----------
# 注意：路径需完整到 \BAAI\bge-m3 一层，否则会被 transformers 误判为 HF repo id
BGE_M3_PATH=D:\ai_models\BAAI\bge-m3
BGE_M3=BAAI/bge-m3
# GPU 设备；CPU 时改为 cpu，并设置 BGE_FP16=0
BGE_DEVICE=cuda:0
# FP16 半精度加速：GPU 开(1) / CPU 关(0)
BGE_FP16=1

# ---------- Milvus（向量库） ----------
# Windows 下务必用 127.0.0.1 而非 localhost（IPv6 解析问题）
MILVUS_URL=http://127.0.0.1:19530
# 存储文档切片向量
CHUNKS_COLLECTION=kb_chunks
# 存储商品名实体集合
ITEM_NAME_COLLECTION=kb_item_names
# ---------- 金融知识库（与旧设备数据隔离） ----------
FINANCE_MONGO_DB_NAME=finance_knowledge_base
FINANCE_CHUNKS_COLLECTION=finance_chunks
FINANCE_WORK_DIR=output/finance
FINANCE_MINIO_BUCKET=finance-knowledge-base
# BGE-M3 稠密向量维度
EMBEDDING_DIM=1024

# ---------- Neo4j（知识图谱，预留） ----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

# ---------- MongoDB（多轮会话历史） ----------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb002

# ---------- MinIO（手册插图对象存储） ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ---------- 重排序模型（BGE-reranker-large，本地部署） ----------
BGE_RERANKER_LARGE=D:\ai_models\BAAI\bge-reranker-large
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1

# ---------- MCP 联网搜索（Tavily WebSearch） ----------
# 阿里云百炼 WebSearch MCP（SSE）
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
# ModelScope MCP 推理地址（个人专属 URL，请替换为自己的）
MCP_WEB_SEARCH_URL=your-mcp-web-search-url

# ---------- minerU API ----------
MINERU_API_TOKEN=your-mineru-token
MINERU_BASE_URL=https://mineru.net/api/v4

# ===================== 日志配置 =====================
# 控制台日志：True=开启/False=关闭，级别可选(DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
# 文件日志：级别与控制台可独立设置，按日切割保留 N 天
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
