# ============ 环境与密钥 ============
.env
.env.*
!.env.example

# ============ Python 虚拟环境 ============
.venv/
venv/
env/

# ============ Python 缓存 / 构建产物 ============
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
*.so

# ============ 测试 / 质量工具缓存 ============
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ============ 日志 ============
logs/
*.log

# ============ IDE / 编辑器 ============
.vscode/
.idea/
*.swp
*.swo

# ============ 系统文件 ============
.DS_Store
Thumbs.db

# ============ Notebook 检查点 ============
.ipynb_checkpoints/

# ============ 本地大文件(需手动下载) ============
# ⚠️ 注意:pyproject.toml 的 [tool.uv.sources] 引用了 _wheels/ 下的本地 torch wheel
# 忽略该目录后,其他人 clone 需自行下载 wheel 放入其中,否则 uv sync 会失败
# 若想保证 clone 后即可同步,请删掉下面这行并把 _wheels/ 提交到仓库
_wheels/
